    "loans = pd.read_csv(\"loans.csv\") # read a csv file named loans\n",
    "X = loans[[\"monthly_income\", \"loan_amount\"]].values # taking a couple of dependent features from the dataset as X\n",
    "y = loans[[\"approved\"]].values # taking a couple of independent features from the dataset as Y\n",
    "\n",
    "X = StandardScaler().fit_transform(X) # this is used for training and scaling the model\n",
    "X = torch.tensor(X, dtype=torch.float32)  # converts X's labels to float(Binary Cross Entropy)\n",
    "y = torch.tensor(y, dtype=torch.float32) # converts Y's labels to float(Binary Cross Entropy)\n",
    "\n",
    "torch.manual_seed(42) # providing seed that randomzies stuff\n",
    "model = nn.Sequential(nn.Linear(2, 8), nn.ReLU(), nn.Linear(8, 1), nn.Sigmoid()) # Relu function and Sigmoid functions are used where 2,8 is the main layer and 8,1  is the hidden layer \n",
    "loss_fn = nn.BCELoss() # here we store the loss using Binary Cross Entropy\n",
    "optimizer = torch.optim.Adam(model.parameters(), lr=0.01) # optimizer is used to update the weights where lea rning rate is 0 .01 \n",
    "\n",
    "for epoch in range(100):  # trainig for 100 epochs \n",
    "    guess = model(X) # Forward Passing\n",
    "    loss = loss_fn(guess, y) # Loss Prediction\n",
    "    optimizer.zero_grad() # clear out the gradients\n",
    "    loss.backward() # Backward Passing\n",
    "    optimizer.step()\n",
    "\n",
    "print(\"final loss:\", round(loss.item(), 3)) # print the final loss where we are rounding the digits by 3"
   ]
